// The layer DLL's version resource, configured by src/vkcore/CMakeLists.txt from the project version.
// Product identity is CircleVR; original source notices are retained separately.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS @CIRCLE_VR_VERSION_FLAGS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CactusVRStudios"
            VALUE "FileDescription", "CircleVR Vulkan/OpenXR renderer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "KharvoxCircle"
            VALUE "OriginalFilename", "KharvoxCircle.dll"
            VALUE "ProductName", "KHARVOX CIRCLE"
            VALUE "ProductVersion", "@CIRCLE_VR_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
